=== 3. HYPRLAND.CONF / HYPRLAND.LUA ===
source = colors.conf

quirks {
    skip_non_kms_dmabuf_formats = false
}

### MONITORS ###
monitor = eDP-1, 1366x768@85.00, auto, 1
monitor = , preferred, auto, 1

### MY PROGRAMS ###
$terminal = kitty
$fileManager = nautilus
$menu = rofi -show run

### AUTOSTART ###
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=Hyprland
exec-once = systemctl --user restart xdg-desktop-portal-hyprland
exec-once = systemctl --user restart xdg-desktop-portal
exec-once = pactl set-card-profile alsa_card.pci-0000_00_1b.0 output:analog-stereo+input:analog-stereo
exec-once = nm-applet
exec-once = blueman-applet
exec-once = systemctl --user start hyprpolkitagent
exec-once = hypridle

### ENVIRONMENT VARIABLES ###
env = XCURSOR_SIZE,18
env = XCURSOR_THEME,Breeze_Light
env = HYPRCURSOR_SIZE,18
env = LIBVA_DRIVER_NAME,i965
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_DESKTOP,Hyprland
env = XDG_DESKTOP_PORTAL,hyprland
env = XDG_DATA_DIRS,/var/lib/flatpak/exports/share:/var/lib/flatpak/exports/share/applications:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
env = XDG_PICTURES_DIR,$HOME/Pictures

### TAGS ###
source= ~/.config/hypr/configs/tags.conf

### LOOK AND FEEL ###
source= ~/.config/hypr/configs/looknfeel.conf

### ANIMATIONS ###
source= ~/.config/hypr/configs/UserAnimations.conf

### WINDOWRULES AND LAYERRULES ###
source = ~/.config/hypr/configs/windowrules.conf

dwindle {
    pseudotile = true
    preserve_split = true
}

master {
    new_status = master
}

misc {
    force_default_wallpaper = 0
    disable_hyprland_logo = true
    vfr = true
}

### INPUT ###
source= ~/.config/hypr/configs/input.conf

### KEYBINDS ###
source= ~/.config/hypr/configs/keybinds.conf


# Carbon Shell Integration
source = ~/.config/carbon/carbon.conf
