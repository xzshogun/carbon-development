[Unit]
Description=Carbon Quickshell Desktop Shell
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=-%h/.config/carbon/carbon-shell.env
Environment=CARBON_CONFIG_DIR=%h/.config/carbon
Environment=QT_QPA_PLATFORM=wayland
Environment=XDG_CURRENT_DESKTOP=Hyprland
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
Environment=MALLOC_CONF=narenas:2,background_thread:true,dirty_decay_ms:2000,muzzy_decay_ms:2000
ExecStart=/usr/bin/bash -c 'RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; mkdir -p "%h/.config/quickshell"; ln -sfn "%h/.local/share/quickshell/carbon" "%h/.config/quickshell/carbon" 2>/dev/null || true; for i in $(seq 1 50); do if [ -z "${WAYLAND_DISPLAY:-}" ]; then for sock in "$RUNTIME_DIR"/wayland-*; do if [ -S "$sock" ]; then export WAYLAND_DISPLAY="$(basename "$sock")"; break; fi; done; fi; if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "$RUNTIME_DIR/hypr" ]; then for hdir in "$RUNTIME_DIR"/hypr/*; do if [ -d "$hdir" ]; then export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$hdir")"; break; fi; done; fi; if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then break; fi; sleep 0.2; done; if [ -x %h/.local/bin/quickshell ]; then exec %h/.local/bin/quickshell -p %h/.local/share/quickshell/carbon; elif command -v quickshell >/dev/null 2>&1; then exec quickshell -p %h/.local/share/quickshell/carbon; else exec /usr/bin/quickshell -p %h/.local/share/quickshell/carbon; fi'
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
